# Copy this file to .env and fill it in. Never commit .env (it is git-ignored).
#
# The answer-generation stages (A5, A6) call an OpenAI-compatible chat endpoint.
# Point these at your model. Examples:
#
# Ollama on your laptop:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1
#   LLM_API_KEY=ollama            # any value; Ollama ignores it
#
# Ollama in Kaggle via an ngrok/cloudflared tunnel:
#   LLM_BASE_URL=https://<your-id>.ngrok-free.app/v1
#   LLM_MODEL=llama3.1
#   LLM_API_KEY=ollama
#
# Groq (hosted):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_API_KEY=gsk_...

LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
